generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(EMPLOYEE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employee     Employee?
}

model Employee {
  id             String         @id @default(cuid())
  userId         String         @unique
  phone          String?
  whatsappNumber String?
  position       String?
  salary         Float?
  address        String?
  hireDate       DateTime?
  avatar         String?
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appointments   Appointment[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
}

model Client {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  email         String?
  company       String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  invoices      Invoice[]
  subscriptions Subscription[]
  tasks         Task[]
  transactions  Transaction[]
}

model Subscription {
  id              String             @id @default(cuid())
  clientId        String
  planName        String
  totalAmount     Float
  paidAmount      Float              @default(0)
  remainingAmount Float              @default(0)
  startDate       DateTime
  endDate         DateTime
  notes           String?
  status          SubscriptionStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  payments        Payment[]
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  amount         Float
  notes          String?
  paymentDate    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String           @id @default(cuid())
  clientId        String?
  customerName    String?
  customerPhone   String?
  title           String
  description     String?
  totalAmount     Float
  paidAmount      Float            @default(0)
  remainingAmount Float            @default(0)
  status          InvoiceStatus    @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments        InvoicePayment[]
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  amount      Float
  notes       String?
  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  notes       String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Appointment {
  id              String            @id @default(cuid())
  title           String
  clientId        String
  employeeId      String?
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customerName    String?
  customerPhone   String?
  endDate         DateTime?
  location        String?
  meetingLink     String?
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee        Employee?         @relation(fields: [employeeId], references: [id])
}

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  clientId    String
  employeeId  String
  dueDate     DateTime
  fileUrl     String?
  priority    TaskPriority   @default(ON_TIME)
  status      TaskStatus     @default(TODO)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  client      Client         @relation(fields: [clientId], references: [id])
  employee    Employee       @relation(fields: [employeeId], references: [id])
  activities  TaskActivity[]
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  action    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  clientId    String
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  VACATION
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  URGENT
  ON_TIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}
